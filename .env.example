# ---------------------------------------------------------------------------
# CV Studio – Konfiguration (Kopie als .env anlegen, Werte anpassen)
# Niemals echte Passwörter oder Schlüssel ins Repository einchecken!
# ---------------------------------------------------------------------------

# Öffentliche URL der Anwendung (für E-Mail-Links und Origin-Prüfung)
APP_URL=https://cv.example.com

# Datenbank (docker-compose nutzt diese Werte für den Postgres-Container)
POSTGRES_DB=cvstudio
POSTGRES_USER=cvstudio
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort-setzen
# Für den Betrieb ohne docker-compose:
# DATABASE_URL=postgres://cvstudio:passwort@localhost:5432/cvstudio
# DATABASE_SSL=false

# Port des Frontends auf dem Host
HTTP_PORT=8080

# Cookies nur über HTTPS senden (auto = in Produktion aktiv)
COOKIE_SECURE=auto
# Anzahl vertrauenswürdiger Reverse-Proxys (für korrekte Client-IP beim Rate Limiting)
TRUST_PROXY=1
SESSION_TTL_DAYS=14

# Optional: Redis für Rate Limiting über mehrere Instanzen (docker compose --profile redis)
# REDIS_URL=redis://redis:6379

# E-Mail (Passwort-Reset). "outbox" legt Mails nur als Datei ab (Entwicklung).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CV Studio <no-reply@example.com>

# Erster Administrator (wird beim Start angelegt, falls nicht vorhanden)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optionaler KI-Assistent (Anthropic Claude). Ohne Schlüssel ist die Funktion deaktiviert.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# PDF-Erzeugung
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=45000

# Angaben für Impressum und Datenschutzerklärung
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_PHONE=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_VAT_ID=

LOG_LEVEL=info
